+/// `mode` with the `want` bits added, or None when none is missing (fix_access only adds bits).
+fn add_bits(mode: u32, want: u32) -> Option<u32> {
+    let mode = mode & 0o7777;
+    (mode & want != want).then_some(mode | want)
+}
